{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit",
    "test": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "test:integration": "bun run __tests__/integration/run-integration-tests.ts",
    "test:integration:e2e": "bun run __tests__/integration/run-integration-tests.ts \"ChatApp E2E\"",
    "test:integration:services": "bun run __tests__/integration/run-integration-tests.ts \"Chat Services\"",
    "test:integration:performance": "bun run __tests__/integration/run-integration-tests.ts \"Performance\"",
    "test:integration:websocket": "bun run __tests__/integration/run-integration-tests.ts \"WebSocket Protocol\"",
    "start:llm": "bun run src/scripts/start-llm-server.ts",
    "start:ws": "bun run src/services/websocket/__tests__/websocket-test-server.ts",
    "dev:full": "concurrently \"bun run start:ws\" \"bun run dev\""
  },
  "dependencies": {
    "@api/core": "*",
    "@buddy/protocol": "workspace:*",
    "@buddy/ui": "*",
