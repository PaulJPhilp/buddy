{
  "id": "simple-chat",
  "name": "Simple Chat",
  "agentId": "simple-agent",
  "toolbarId": "simple-toolbar",
  "themeId": "simple-theme",
  "description": "A simple chat application for testing",
  "version": "1.0.0",
  "isDefault": true,
  "isShared": true,
  "spaceId": "default-space",

  "agent": {
    "id": "simple-agent",
    "initialAgentName": "Simple Agent"
  },

  "toolbar": {
    "id": "simple-toolbar",
    "name": "Simple Toolbar",
    "tools": []
  },

  "style": {
    "colors": {
      "primary": "#3b82f6",
      "secondary": "#e5e7eb",
      "accent": "#1d4ed8",
      "background": "#ffffff",
      "text": "#1f2937"
    },
    "borders": {
      "color": "#d1d5db",
      "thickness": "1px",
      "radius": "0.5rem"
    },
    "bubbles": {
      "user": {
        "background": "#3b82f6",
        "text": "white",
        "radius": "rounded-lg",
        "border": "1px solid #2563eb",
        "padding": "0.5rem 0.75rem"
      },
      "agent": {
        "background": "#f3f4f6",
        "text": "#1f2937",
        "radius": "rounded-lg",
        "border": "1px solid #d1d5db",
        "padding": "0.5rem 0.75rem"
      }
    },
    "userArea": {
      "background": "#f9fafb",
      "inputRingColor": "blue-500",
      "padding": "0.5rem"
    },
    "header": {
      "background": "#3b82f6",
      "text": "white",
      "borderBottom": "1px solid #2563eb",
      "padding": "0.5rem 1rem"
    },
    "chatArea": {
      "background": "#ffffff",
      "border": "1px solid #d1d5db",
      "radius": "0.5rem",
      "padding": "0.75rem"
    },
    "typography": {
      "fontFamily": "Inter, sans-serif",
      "fontSize": "0.875rem"
    }
  }
}
