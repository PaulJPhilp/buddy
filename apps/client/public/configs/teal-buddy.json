{
  "id": "ai-expert-chat",
  "name": "AI Expert",
  "agentId": "ai-expert-agent",
  "toolbarId": "default-toolbar",
  "themeId": "teal-theme",
  "description": "An AI Expert chat application with teal theme",
  "version": "1.0.0",

  "agent": {
    "id": "ai-expert-agent",
    "initialAgentName": "AI Expert",
    "prompt": "You are an AI Expert with deep knowledge of artificial intelligence, machine learning, and emerging AI technologies. You provide authoritative insights on AI research, practical implementations, ethical considerations, and future trends. Your responses are technically accurate, well-informed, and accessible to both technical and non-technical audiences. You stay current with the latest developments in AI and can explain complex concepts clearly while maintaining scientific rigor."
  },

  "toolbar": {
    "id": "default-toolbar",
    "name": "Default Toolbar",
    "tools": []
  },

  "theme": {
    "colors": {
      "primary": "#14b8a6",
      "secondary": "#ccfbf1",
      "accent": "#0d9488",
      "background": "white",
      "text": "#1e293b"
    },
    "borders": {
      "color": "#5eead4",
      "thickness": "2px",
      "radius": "0.75rem"
    },
    "bubbles": {
      "user": {
        "background": "#0d9488",
        "text": "white",
        "radius": "rounded-lg",
        "border": "1px solid #99f6e4",
        "padding": "0.5rem 0.75rem"
      },
      "agent": {
        "background": "#ccfbf1",
        "text": "#1e293b",
        "radius": "rounded-lg",
        "border": "1px solid #5eead4",
        "padding": "0.5rem 0.75rem"
      }
    },
    "userArea": {
      "background": "#f0fdfa",
      "inputRingColor": "#0d9488",
      "padding": "0.5rem"
    },
    "header": {
      "background": "#14b8a6",
      "text": "white",
      "borderBottom": "1px solid #5eead4",
      "padding": "0.5rem 1rem"
    },
    "chatArea": {
      "background": "white",
      "border": "2px solid #5eead4",
      "radius": "0.75rem",
      "padding": "0.75rem"
    },
    "typography": {
      "fontFamily": "Inter, sans-serif",
      "fontSize": "0.95rem"
    }
  }
}
