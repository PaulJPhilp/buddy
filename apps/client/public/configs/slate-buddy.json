{
  "id": "slate-chat",
  "name": "Slate Chat",
  "agentId": "slate-agent",
  "toolbarId": "default-toolbar",
  "themeId": "slate-theme",
  "description": "A slate-themed chat application",
  "version": "1.0.0",

  "agent": {
    "id": "slate-agent",
    "initialAgentName": "Slate Agent"
  },

  "toolbar": {
    "id": "default-toolbar",
    "name": "Default Toolbar",
    "tools": []
  },

  "style": {
    "colors": {
      "primary": "#475569",
      "secondary": "#f1f5f9",
      "accent": "#334155",
      "background": "white",
      "text": "#0f172a"
    },
    "borders": {
      "color": "#94a3b8",
      "thickness": "2px",
      "radius": "0.75rem"
    },
    "bubbles": {
      "user": {
        "background": "#334155",
        "text": "white",
        "radius": "rounded-lg",
        "border": "1px solid #cbd5e1",
        "padding": "0.5rem 0.75rem"
      },
      "agent": {
        "background": "#f1f5f9",
        "text": "#0f172a",
        "radius": "rounded-lg",
        "border": "1px solid #94a3b8",
        "padding": "0.5rem 0.75rem"
      }
    },
    "userArea": {
      "background": "#f8fafc",
      "inputRingColor": "#334155",
      "padding": "0.5rem"
    },
    "header": {
      "background": "#475569",
      "text": "white",
      "borderBottom": "1px solid #94a3b8",
      "padding": "0.5rem 1rem"
    },
    "chatArea": {
      "background": "white",
      "border": "2px solid #94a3b8",
      "radius": "0.75rem",
      "padding": "0.75rem"
    },
    "typography": {
      "fontFamily": "Inter, sans-serif",
      "fontSize": "0.95rem"
    }
  }
}
