{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "rootDir": "../..",
    "rootDirs": ["src", "../../packages/ui/src"],
    "types": ["@testing-library/jest-dom"],
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@effect/language-server"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@client/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@components/*": ["./src/components/*"],
      "@domain/*": ["./src/domain/*"],
      "@managers/*": ["./src/managers/*"],
      "@services/*": ["./src/services/*"],
      "@schemas/*": ["./src/schemas/*"],
      "@types/*": ["./src/types/*"],
      "@ui-state/*": ["./src/ui-state/*"],
      "@utils/*": ["./src/utils/*"],
      "@buddy/ui": ["../../packages/ui/src"],
      "@buddy/ui/*": ["../../packages/ui/src/*"],
      "@buddy/agentkit": ["../../packages/agentkit"],
      "@buddy/agentkit/*": ["../../packages/agentkit/*"]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    "../../packages/ui/src/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "_archived",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.*.ts",
    "__tests__/**/*"
  ]
}
