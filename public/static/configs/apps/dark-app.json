{
  "id": "dark-app",
  "name": "Dark App Style",
  "description": "Modern dark theme with high contrast and professional appearance",
  "version": "1.0.0",
  "style": {
    "background": "#0f172a",
    "foreground": "#f8fafc",
    "fontFamily": "\"Geist\", system-ui, sans-serif",
    "minHeight": "100vh",
    "borderRadius": "0px",
    "shadow": "none",

    "headerHeight": "28px",
    "headerBackground": "#1e293b",
    "headerForeground": "#f8fafc",
    "headerBorder": "#334155",
    "headerShadow": "0 1px 3px 0 rgba(0, 0, 0, 0.3)",
    "headerPadding": "6px",
    "headerGap": "6px",
    "headerFontSize": "13px",
    "headerFontWeight": "600",
    "headerBorderRadius": "0px",

    "headerButtonPadding": "4px",
    "headerButtonBorderRadius": "8px",
    "headerButtonBackground": "transparent",
    "headerButtonForeground": "#94a3b8",
    "headerButtonHoverBackground": "#334155",
    "headerButtonHoverForeground": "#f1f5f9",
    "headerButtonActiveBackground": "#475569",
    "headerButtonBorder": "none",
    "headerButtonIconSize": "14px",

    "sidebarWidth": "180px",
    "sidebarBackground": "#1e293b",
    "sidebarForeground": "#f8fafc",
    "sidebarBorder": "#334155",
    "sidebarShadow": "2px 0 4px 0 rgba(0, 0, 0, 0.2)",
    "sidebarPadding": "0px",
    "sidebarBorderRadius": "0px",
    "sidebarTransitionDuration": "250ms",
    "sidebarZIndex": "30",

    "mainBackground": "#0f172a",
    "mainForeground": "#f8fafc",
    "mainPadding": "0px",
    "mainBorderRadius": "0px",
    "mainTransitionDuration": "250ms",
    "mainOverflow": "hidden",

    "loadingBackground": "#1e293b",
    "loadingForeground": "#94a3b8",
    "loadingSpinnerColor": "#06b6d4",
    "loadingSpinnerSize": "36px",
    "loadingTextSize": "15px",
    "loadingPadding": "28px",
    "loadingBorderRadius": "12px",
    "loadingShadow": "0 8px 16px -4px rgba(0, 0, 0, 0.3)",

    "errorBackground": "#450a0a",
    "errorForeground": "#fca5a5",
    "errorBorder": "#7f1d1d",
    "errorButtonBackground": "#dc2626",
    "errorButtonForeground": "#ffffff",
    "errorButtonHoverBackground": "#b91c1c",
    "errorPadding": "28px",
    "errorBorderRadius": "12px",
    "errorShadow": "0 8px 16px -4px rgba(0, 0, 0, 0.3)",
    "errorTitleSize": "20px",
    "errorTextSize": "15px",
    "errorButtonPadding": "10px 20px",
    "errorButtonBorderRadius": "8px",

    "authButtonBackground": "#06b6d4",
    "authButtonForeground": "#ffffff",
    "authButtonHoverBackground": "#0891b2",
    "authButtonPadding": "6px 12px",
    "authButtonBorderRadius": "6px",
    "authButtonFontSize": "13px",
    "authButtonFontWeight": "500",

    "mobileBreakpoint": "768px",
    "tabletBreakpoint": "1024px",
    "desktopBreakpoint": "1280px",
    "mobileSidebarWidth": "300px",
    "mobileHeaderHeight": "60px"
  }
}
