{
  "id": "minimal-app",
  "name": "Minimal App Style",
  "description": "Clean, spacious design with minimal visual elements and subtle colors",
  "version": "1.0.0",
  "style": {
    "background": "#ffffff",
    "foreground": "#374151",
    "fontFamily": "\"Inter\", system-ui, sans-serif",
    "minHeight": "100vh",
    "borderRadius": "0px",
    "shadow": "none",

    "headerHeight": "32px",
    "headerBackground": "#ffffff",
    "headerForeground": "#374151",
    "headerBorder": "#f3f4f6",
    "headerShadow": "none",
    "headerPadding": "8px",
    "headerGap": "8px",
    "headerFontSize": "14px",
    "headerFontWeight": "400",
    "headerBorderRadius": "0px",

    "headerButtonPadding": "6px",
    "headerButtonBorderRadius": "4px",
    "headerButtonBackground": "transparent",
    "headerButtonForeground": "#9ca3af",
    "headerButtonHoverBackground": "#f9fafb",
    "headerButtonHoverForeground": "#374151",
    "headerButtonActiveBackground": "#f3f4f6",
    "headerButtonBorder": "none",
    "headerButtonIconSize": "16px",

    "sidebarWidth": "200px",
    "sidebarBackground": "#ffffff",
    "sidebarForeground": "#374151",
    "sidebarBorder": "#f3f4f6",
    "sidebarShadow": "none",
    "sidebarPadding": "8px",
    "sidebarBorderRadius": "0px",
    "sidebarTransitionDuration": "300ms",
    "sidebarZIndex": "30",

    "mainBackground": "#ffffff",
    "mainForeground": "#374151",
    "mainPadding": "16px",
    "mainBorderRadius": "0px",
    "mainTransitionDuration": "300ms",
    "mainOverflow": "hidden",

    "loadingBackground": "#ffffff",
    "loadingForeground": "#9ca3af",
    "loadingSpinnerColor": "#374151",
    "loadingSpinnerSize": "28px",
    "loadingTextSize": "16px",
    "loadingPadding": "32px",
    "loadingBorderRadius": "0px",
    "loadingShadow": "none",

    "errorBackground": "#ffffff",
    "errorForeground": "#dc2626",
    "errorBorder": "#fecaca",
    "errorButtonBackground": "#dc2626",
    "errorButtonForeground": "#ffffff",
    "errorButtonHoverBackground": "#b91c1c",
    "errorPadding": "32px",
    "errorBorderRadius": "0px",
    "errorShadow": "none",
    "errorTitleSize": "20px",
    "errorTextSize": "16px",
    "errorButtonPadding": "12px 24px",
    "errorButtonBorderRadius": "4px",

    "authButtonBackground": "#374151",
    "authButtonForeground": "#ffffff",
    "authButtonHoverBackground": "#1f2937",
    "authButtonPadding": "8px 16px",
    "authButtonBorderRadius": "4px",
    "authButtonFontSize": "14px",
    "authButtonFontWeight": "400",

    "mobileBreakpoint": "768px",
    "tabletBreakpoint": "1024px",
    "desktopBreakpoint": "1280px",
    "mobileSidebarWidth": "320px",
    "mobileHeaderHeight": "64px"
  }
}
