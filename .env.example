# Buddy Application - Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# API Keys (Required for AI functionality)
# =============================================================================

# OpenAI API Key - Required for OpenAI models
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Generative AI API Key - Required for Google/Gemini models
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# Anthropic API Key - Required for Claude models
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# Clerk Authentication (Required for user authentication)
# =============================================================================

# Clerk Publishable Key - Public key for client-side
# Get from: https://dashboard.clerk.com/ -> Your App -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Clerk Secret Key - Private key for server-side
# Get from: https://dashboard.clerk.com/ -> Your App -> API Keys
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Clerk Sign In URL (Optional - defaults to /sign-in)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Clerk Sign Up URL (Optional - defaults to /sign-up)
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk After Sign In URL (Optional - defaults to /)
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Clerk After Sign Up URL (Optional - defaults to /)
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# =============================================================================
# Application URLs (Required for development and production)
# =============================================================================

# Next.js API URL - Base URL for API endpoints
# Development: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket Server URL - URL for real-time communication
# Development: ws://localhost:3001
# Production: wss://your-ws-server.com
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# WebSocket Host (Optional - defaults to localhost)
NEXT_PUBLIC_WS_HOST=localhost

# Agent Server URL (Optional - for external agent services)
NEXT_PUBLIC_AGENT_URL=http://localhost:3002

# =============================================================================
# Security & CORS (Optional)
# =============================================================================

# Allowed Origins for Server Actions (comma-separated)
# Example: https://your-app.com,https://www.your-app.com
ALLOWED_ORIGINS=

# =============================================================================
# Node Environment (Automatically set by framework)
# =============================================================================

# NODE_ENV=development  # Set by framework (development, production, test)

# =============================================================================
# Vercel Deployment (Optional - automatically set by Vercel)
# =============================================================================

# VERCEL_URL                    # Automatically set by Vercel
# VERCEL_ENV                    # Automatically set by Vercel (production, preview, development)
# VERCEL_GIT_COMMIT_SHA         # Automatically set by Vercel
# VERCEL_GIT_COMMIT_MESSAGE     # Automatically set by Vercel

# =============================================================================
# Development Tools (Optional)
# =============================================================================

# Enable debug logging
# DEBUG=true

# Disable console logs in production (handled by next.config.ts)
# Automatically removes console.log in production builds

# =============================================================================
# Notes
# =============================================================================

# 1. NEVER commit .env.local or .env files with real credentials to git
# 2. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# 3. Variables without NEXT_PUBLIC_ are server-side only
# 4. For production, set these in your hosting platform (Vercel, etc.)
# 5. For local development, copy this to .env.local and fill in values

# =============================================================================
# Quick Start
# =============================================================================

# 1. Copy this file:
#    cp .env.example .env.local

# 2. Fill in required API keys:
#    - At minimum: One AI provider key (OpenAI, Google, or Anthropic)
#    - Clerk keys for authentication

# 3. Start development:
#    bun dev

# 4. For WebSocket testing:
#    bun run start:ws
#    bun run dev:full  # Starts both Next.js and WebSocket server
