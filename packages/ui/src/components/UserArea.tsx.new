// filepath: /Users/paul/Projects/buddy/packages/ui/src/components/UserArea.tsx
import { Effect } from "effect";
import * as Ref from "effect/Ref";
import React, { useState } from "react";

import { AttachmentRow } from "./AttachmentRow";
import { MinimalInput } from "./MinimalInput";
import { UIBar, UIBarElementConfig } from "./UIBar";

export interface UserAreaProps {
    onSubmitMessageEffect: (text: string) => Effect.Effect<void, Error>;
    uiBarElements?: UIBarElementConfig[];
    error?: string | null;
    onDismissErrorAction?: Effect.Effect<void, Error>;
    onCloseAction?: Effect.Effect<void, Error>;
    attachedFiles?: Array<File>; // For Stage 6, provide a placeholder for now
    onRemoveFileEffect?: (file: File) => Effect.Effect<void, Error>; // For Stage 6
}

export const UserArea: React.FC<UserAreaProps> = ({
    onSubmitMessageEffect,
    uiBarElements,
    error,
    onDismissErrorAction,
    onCloseAction,
    attachedFiles = [], // Default to empty array
    onRemoveFileEffect,
}) => {
    const runtime = typeof window !== 'undefined' ? (window as any).effectTsRuntime : undefined;
    const [currentText, setCurrentText] = useState("");
    const [showEmoji, setShowEmoji] = useState(false);

    const showErrorRow = !!error;
    const showCloseButton = !!onCloseAction;
    const showAttachmentRow = attachedFiles.length > 0;
    const showSubInputUIBar = !!uiBarElements && uiBarElements.length > 0;

    const handleTextChange = (newText: string) => {
        setCurrentText(newText);
    };

    // Create trailing accessories for MinimalInput
    const inputTrailingElements: UIBarElementConfig[] = [
        {
            type: "iconCommand",
            iconName: "emoji",
            effect: Effect.sync(() => {
                setShowEmoji(!showEmoji);
                console.log("Toggle emoji picker");
            }),
            tooltip: "Toggle emoji picker",
            id: "emoji-toggle"
        },
        {
            type: "iconCommand",
            iconName: "attach",
            effect: Effect.sync(() => {
                console.log("Open attachment dialog");
            }),
            tooltip: "Add attachment",
            id: "attachment-button"
        }
    ];

    const handleSubmit = () => {
        if (currentText.trim() === "") {
            return; // Do nothing if text is empty
        }

        const effectToRun = onSubmitMessageEffect(currentText).pipe(
            Effect.tap(() => Effect.sync(() => setCurrentText(""))) // Clear input after effect succeeds
        );

        if (runtime) {
            runtime.runPromise(effectToRun).catch((err: unknown) => {
                console.error("Error submitting message via UserArea:", err);
                // Optionally, set a local error state here to display in the UI
            });
        } else {
            console.error("UserArea: Effect runtime not available. Message submission via Effect failed.");
            // Fallback behavior: maybe try to submit without Effect or show an error
            // For now, just logging. ChatApp's RuntimeProvider should make runtime available.
        }
    };

    const runSideEffect = <E, A>(effectToRun: Effect.Effect<A, E>, errorHandler?: (err: unknown) => void) => {
        if (runtime) {
            runtime.runPromise(effectToRun).catch(errorHandler || ((err: unknown) => console.error("Error running side effect:", err)));
        } else {
            console.error("UserArea: Effect runtime not available for the requested action.");
        }
    };

    const runDismissError = () => {
        if (onDismissErrorAction) {
            runSideEffect(onDismissErrorAction, (err: unknown) => console.error("Error dismissing error:", err));
        }
    };

    const runCloseAction = () => {
        if (onCloseAction) {
            runSideEffect(onCloseAction, (err: unknown) => console.error("Error running close action:", err));
        }
    };

    // Warning if runtime is not available but effect-based props are configured
    if (!runtime && (onCloseAction || onDismissErrorAction)) {
        console.warn("UserArea: Effect runtime is not available, but onDismissErrorAction or onCloseAction are defined and require it.");
    }

    return (
        <div className="p-2 border-t border-border bg-muted/40">
            <div className="grid grid-rows-[auto_auto_auto_auto] gap-2">
                {(showErrorRow || showCloseButton) && (
                    <div
                        className={`p-1 text-xs rounded-sm flex justify-between items-center ${showErrorRow ? "bg-destructive text-destructive-foreground" : ""
                            }`}
                    >
                        {showErrorRow && (
                            <span className="flex-1">{error}</span>
                        )}
                        {showErrorRow && onDismissErrorAction && (
                            <button
                                type="button"
                                onClick={runDismissError}
                                className="ml-2 p-0.5 rounded-sm hover:bg-destructive-foreground/20"
                                aria-label="Dismiss error"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                            </button>
                        )}
                        {showCloseButton && !showErrorRow && <div className="flex-1" />}
                        {showCloseButton && (
                            <button
                                type="button"
                                onClick={runCloseAction}
                                className={`p-0.5 rounded-sm ${showErrorRow ? "hover:bg-destructive-foreground/20" : "hover:bg-muted-foreground/20 text-muted-foreground"}`}
                                aria-label="Close chat"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                            </button>
                        )}
                    </div>
                )}

                {showAttachmentRow && onRemoveFileEffect && (
                    <div className="p-1 bg-background border border-border rounded-sm">
                        <AttachmentRow
                            attachedFiles={attachedFiles || []}
                            onRemoveFileEffect={onRemoveFileEffect}
                            className="py-0.5"
                        />
                    </div>
                )}

                <MinimalInput
                    text={currentText}
                    onTextChange={handleTextChange} // Standard React prop
                    onSubmit={handleSubmit}         // Standard React prop
                    onSubmitEffectFromParent={onSubmitMessageEffect} // Effect-based prop
                    trailingAccessoryElements={inputTrailingElements}
                    accessoryBarProps={{
                        gap: "space-x-2",
                        className: "px-1"
                    }}
                />

                {showSubInputUIBar && uiBarElements && (
                    <div className="mt-1">
                        <UIBar elements={uiBarElements} />
                    </div>
                )}

                {showEmoji && (
                    <div className="p-2 bg-background border border-input rounded-md text-sm">
                        Emoji Picker Placeholder
                    </div>
                )}
            </div>
        </div>
    );
};

export default UserArea;
