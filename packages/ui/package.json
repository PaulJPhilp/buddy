{
  "name": "@buddy/ui",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist/**", "src/styles/**"],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe ."
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./lib/utils": {
      "types": "./src/lib/utils.ts",
      "import": "./src/lib/utils.ts",
      "require": "./src/lib/utils.ts"
    },
    "./styles": "./src/styles/globals.css",
    "./globals.css": "./src/styles/globals.css",
    "./tailwind.config": "./tailwind.config.ts"
  },
  "dependencies": {
