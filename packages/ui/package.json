    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "diff-match-patch": "^1.0.5",
    "effect": "^3.16.12",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^11.18.2",
    "geist": "^1.4.2",
    "glob": "^11.0.3",
    "inflight": "^1.0.6",
    "orderedmap": "^2.1.1",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.7",
    "react-data-grid": "7.0.0-beta.47",
    "react-markdown": "^10.1.0",
